{
  "root": false,
  "extends": [
    "../../.eslintrc.json",
    "next/core-web-vitals"
  ],
  "env": {
    "browser": true,
    "es2020": true,
    "node": true
  },
  "overrides": [
    {
      "files": ["**/*.ts", "**/*.tsx"],
      "rules": {
        "react/react-in-jsx-scope": "off",
        "@next/next/no-img-element": "warn",
        "@next/next/no-html-link-for-pages": "warn"
      }
    }
  ]
}
