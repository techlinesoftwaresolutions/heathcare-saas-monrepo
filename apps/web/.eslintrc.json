{
  "root": false,
  "extends": [
    "../../.eslintrc.json"
  ],
  "env": {
    "browser": true,
    "es2020": true,
    "node": true
  },
  "overrides": [
    {
      "files": [
        "**/*.ts",
        "**/*.tsx"
      ],
      "rules": {
        "react/react-in-jsx-scope": "off"
      }
    }
  ]
}
